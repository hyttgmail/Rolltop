# UI — shared components and the fixed names of system menu bar items (Apple's zh-Hans names).
"AirDrop" = "隔空投送"
"Allow Rolltop in System Settings › Privacy & Security › Device Control and Data Access." = "在“系统设置 › 隐私与安全 › 设备控制和数据访问”中允许 Rolltop。"
"Allow Rolltop in System Settings › Privacy & Security › Screen & System Audio Recording." = "在“系统设置 › 隐私与安全 › 录屏与系统录音”中允许 Rolltop。"
"Allowed" = "已允许"
"Always hidden" = "始终隐藏"
"Battery" = "电池"
"Bluetooth" = "蓝牙"
"Clock" = "时钟"
"Control Center" = "控制中心"
# Permission names are the macOS 27 Privacy & Security pane names (glossary).
"Device Control and Data Access" = "设备控制和数据访问"
"Displays" = "显示器"
"Hidden" = "隐藏"
"Input menu" = "输入法菜单"
"Keyboard Brightness" = "键盘亮度"
"Not allowed" = "未允许"
"Open System Settings" = "打开系统设置"
"Optional" = "可选"
"Required" = "必需"
"Screen & System Audio Recording" = "录屏与系统录音"
"Screen Mirroring" = "屏幕镜像"
"Shown" = "显示"
"Sound" = "声音"
# Apple calls Spotlight 聚焦 (System Settings › Siri 与聚焦).
"Spotlight" = "聚焦"
"Time Machine and other system items" = "时间机器和其他系统项"
# Apple's zh-Hans name for Wi-Fi.
"Wi-Fi" = "Wi-Fi"
# Consent rows (Settings › Permissions, "Features that need your permission").
"Not asked yet" = "尚未请求"
"Can’t ask now" = "暂时无法请求"
"Unavailable" = "不可用"
"Checking…" = "正在检查…"
# Location errors (Platform/LocationAccess). Location Services = 定位服务 (glossary).
"Rolltop isn’t allowed to use your location." = "未允许 Rolltop 使用你的位置。"
"Location Services are turned off." = "定位服务已关闭。"
"Your location couldn’t be found in time." = "未能及时确定你的位置。"
"Your location couldn’t be found." = "无法确定你的位置。"
# Now Playing players: Apple's zh-Hans name of the Music app is 音乐.
"Music" = "音乐"
"Spotify" = "Spotify"
# Focus (glossary: 专注模式).
"Rolltop can’t tell whether a Focus is on." = "Rolltop 无法判断专注模式是否已打开。"
# Weather conditions (Open-Meteo WMO codes) and the attribution its licence requires.
"Clear" = "晴朗"
"Mainly clear" = "大部晴朗"
"Partly cloudy" = "局部多云"
"Overcast" = "阴天"
"Fog" = "雾"
"Drizzle" = "毛毛雨"
"Freezing drizzle" = "冻毛毛雨"
"Rain" = "雨"
"Freezing rain" = "冻雨"
"Snow" = "雪"
"Rain showers" = "阵雨"
"Snow showers" = "阵雪"
"Thunderstorm" = "雷暴"
"Thunderstorm with hail" = "雷暴伴有冰雹"
"Unknown conditions" = "天气未知"
"Weather data by Open-Meteo.com" = "天气数据来自 Open-Meteo.com"
