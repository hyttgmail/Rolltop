# InfoPlist — permission prompts macOS shows on Rolltop's behalf (keys are Info.plist keys).
"NSAppleEventsUsageDescription" = "Rolltop 使用 Apple 事件来运行你设置的脚本和自动化，并显示和控制“音乐”或 Spotify 中正在播放的内容。"
"NSCalendarsFullAccessUsageDescription" = "Rolltop 会在搁架和小组件中显示你即将开始的日程。"
"NSLocationUsageDescription" = "Rolltop 仅在你设置的自动化中使用你的位置：读取当前 Wi-Fi 网络的名称，以及检查地点条件。"
"NSLocationWhenInUseUsageDescription" = "Rolltop 仅在你设置的自动化中使用你的位置：读取当前 Wi-Fi 网络的名称，以及检查地点条件。"
