"Done" = "完成"
"Duplicate" = "复制"
"Edit…" = "编辑…"
"Ended" = "已结束"
"Ends the next day." = "于次日结束。"
"Every %lld s" = "每 %lld 秒"
"Every day" = "每天"
"Exactly this many displays" = "显示器数量正好为"
"From" = "从"
"Holds now" = "当前满足"
"If the automation is active, it ends first." = "如果该自动化处于激活状态，会先将其结束。"
"In the menu bar" = "菜单栏中的项"
"Inactive" = "未激活"
"Interval" = "间隔"
"Item changed" = "项发生变化"
