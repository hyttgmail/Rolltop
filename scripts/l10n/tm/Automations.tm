"on %@" = "已连接到%@"
"on battery power" = "使用电池供电"
"on power adapter" = "使用电源适配器"
"rules, triggers, conditions, battery, power, wi-fi, network, schedule, time, apps, script" = "自动化, 规则, 触发器, 条件, 电池, 电源, Wi-Fi, 无线局域网, 网络, 日程, 时间, App, 脚本"
"run a command" = "运行命令"
"script succeeds" = "脚本运行成功"
"show %@" = "显示%@"
