"unsupported condition" = "不支持的条件"
# Place conditions (round 2). A place = 地点; Location access = 定位权限.
"Place" = "地点"
"Location unknown" = "位置未知"
"At this place" = "位于此地点"
"Away from this place" = "不在此地点"
# Placeholder: an example place name.
"Office" = "办公室"
"Place name" = "地点名称"
"Latitude" = "纬度"
"Longitude" = "经度"
"Enter a latitude from −90 to 90 and a longitude from −180 to 180." = "请输入 −90 到 90 之间的纬度和 −180 到 180 之间的经度。"
"Radius" = "半径"
"Use Current Location" = "使用当前位置"
"Places are saved with your automations, so they are included in exports and backups." = "地点随自动化一起存储，因此会包含在导出和备份中。"
"Rolltop can tell whether this Mac is at your places." = "Rolltop 可以判断这台 Mac 是否位于你设定的地点。"
"Place conditions need Location access. Until you allow it, the location is unknown and they don’t hold." = "地点条件需要定位权限。在你允许之前，位置未知，这些条件均不满足。"
"Location access is off for Rolltop, so the location is unknown and place conditions don’t hold." = "Rolltop 的定位权限已关闭，因此位置未知，地点条件均不满足。"
# Rule summary when the place has no name yet.
"a place" = "某个地点"
# Rule summary: the place's name (never its coordinates).
"at %@" = "位于 %@"
"away from %@" = "不在 %@"
