# Automations — 自动化 (the objects are called automations, not rules). A condition "holds" = 满足.
# A time condition: weekdays, start–end.
"%@ %@–%@" = "%1$@ %2$@–%3$@"
# Name of a duplicated automation.
"%@ copy" = "%@ 副本"
"%@ is frontmost" = "%@ 位于最前面"
"%@ is not frontmost" = "%@ 未位于最前面"
"%@ is not running" = "%@ 未在运行"
"%@ is running" = "%@ 正在运行"
# Fractions of a second, e.g. 0.5.
"%@ seconds" = "%@ 秒"
# Backup summary: "3 automations, 1 with scripts (imported turned off)".
"%@, %lld with scripts (imported turned off)" = "%1$@，其中 %2$lld 个含脚本（导入后为关闭状态）"
"%lld automations" = "%lld 个自动化"
  en = {"one": "%lld automation", "other": "%lld automations"}
"%lld seconds" = "%lld 秒"
  en = {"one": "%lld second", "other": "%lld seconds"}
"Active now" = "已激活"
"Active when" = "激活条件"
"Add" = "添加"
"Add Automation" = "添加自动化"
"Add Condition" = "添加条件"
"Add Item" = "添加项"
"All conditions hold" = "满足所有条件"
"All day." = "全天。"
"Allow Rolltop to run this command" = "允许 Rolltop 运行此命令"
"Allowed" = "已允许"
"Allow…" = "允许…"
"An automation is active while its conditions hold. Items it shows hide again by themselves when it ends." = "自动化在其条件满足时处于激活状态。它显示的项会在它结束时自动重新隐藏。"
"An external display is connected" = "连接了外接显示器"
"Any condition holds" = "满足任一条件"
"App" = "App"
"Applied profile “%@”" = "已应用预设“%@”"
"Apply profile" = "应用预设"
"At least this many displays" = "显示器数量至少为"
