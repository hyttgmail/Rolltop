# Profiles — 预设 (PLAN wording): saved menu bar layouts.
# A profile's name in Shortcuts and the status menu, shown as is.
"%@" = "%@"
# Name of a duplicated profile.
"%@ copy" = "%@ 副本"
"%lld hidden, %lld always hidden" = "%1$lld 个隐藏，%2$lld 个始终隐藏"
"%lld profiles" = "%lld 个预设"
  en = {"one": "%lld profile", "other": "%lld profiles"}
"A profile remembers which section every item is in. Apply one here, from Rolltop’s menu, with a shortcut or from an automation." = "预设会记住每一项所在的分区。可以在此处、Rolltop 菜单、快捷键或自动化中应用预设。"
"A profile with a display rule is applied when the connected displays change to match it. When none matches, nothing changes." = "设有显示器规则的预设会在连接的显示器变为与之匹配时应用。没有匹配的预设时，不会有任何变化。"
"Active" = "使用中"
"Active profile" = "当前预设"
"Active, changed" = "使用中，已更改"
"Also applies" = "同时应用"
"An external display is connected" = "连接了外接显示器"
"Apply" = "应用"
"Apply Next Profile" = "应用下一个预设"
"Apply Previous Profile" = "应用上一个预设"
"Apply Profile" = "应用预设"
"Apply at launch" = "启动时应用"
"Apply automatically" = "自动应用"
"Apply when" = "应用条件"
"Cancel" = "取消"
"Connected" = "已连接"
"Could not import the profile" = "无法导入预设"
"Delete" = "删除"
"Delete Profile" = "删除预设"
"Delete “%@”?" = "要删除“%@”吗？"
"Delete…" = "删除…"
"Displays connected now" = "当前连接的显示器"
"Done" = "完成"
"Duplicate" = "复制"
"Edit…" = "编辑…"
"Export…" = "导出…"
# Default name of a profile read from a file.
"Imported profile" = "导入的预设"
"Import…" = "导入…"
"Include Rolltop Bar settings" = "包括 Rolltop 栏设置"
"Include menu bar appearance" = "包括菜单栏外观"
"More" = "更多"
"Move Down" = "下移"
"Move Up" = "上移"
"Name" = "名称"
"Never" = "永不"
"No profiles yet. Arrange the menu bar the way you want it, then save it as a profile." = "尚无预设。按你想要的方式整理菜单栏，然后将其存储为预设。"
"Not connected" = "未连接"
"OK" = "好"
"Only one profile can do this. A profile whose display rule matches at launch takes precedence." = "只有一个预设可以这样设置。启动时显示器规则匹配的预设优先。"
"Only the built-in display is connected" = "只连接了内建显示器"
"Profile" = "预设"
# Status menu slot before a profile exists there.
"Profile %lld" = "预设 %lld"
"Profiles" = "预设"
"Revert" = "复原"
"Save" = "存储"
"Save Current Setup as Profile" = "将当前设置存储为预设"
"Save Current Setup…" = "存储当前设置…"
"Saved profiles" = "已存储的预设"
"Saves which section every item is in. You can include appearance and Rolltop Bar settings afterward." = "存储每一项所在的分区。之后还可以包括外观和 Rolltop 栏设置。"
"Show profiles in Rolltop’s menu" = "在 Rolltop 菜单中显示预设"
"Rolltop Bar" = "Rolltop 栏"
"Switching" = "切换"
"Symbol" = "符号"
"The file is not a Rolltop profile." = "该文件不是 Rolltop 预设。"
"The first five profiles appear in Rolltop’s menu." = "前五个预设会显示在 Rolltop 菜单中。"
"The menu bar changed since this profile was applied. Update the profile to keep the changes, or revert to it." = "应用此预设后菜单栏已有更改。可以更新预设以保留这些更改，或复原为该预设。"
"The menu bar stays as it is. This can’t be undone." = "菜单栏保持现状。此操作无法撤销。"
"There are no profiles." = "没有预设。"
"There is no profile “%@”." = "没有名为“%@”的预设。"
"These displays are connected" = "连接了以下显示器"
"Turning one on stores the current settings with this profile. Applying the profile puts them back." = "开启后会将当前设置存储到此预设中，应用预设时会恢复这些设置。"
"Update Profile" = "更新预设"
"Use the Displays Connected Now" = "使用当前连接的显示器"
# Placeholder for a new profile's name.
"Work" = "工作"
# Summary fragments, joined with " · " in a profile's row.
"always hidden" = "始终隐藏"
"appearance" = "外观"
"at launch" = "启动时应用"
"hidden" = "隐藏"
"new items %@" = "新项：%@"
"presets, layouts, setups, displays, switch" = "预设, 布局, 配置, 显示器, 切换"
"shown" = "显示"
"with %@" = "连接 %@ 时"
"with an external display" = "连接外接显示器时"
"with the built-in display only" = "仅内建显示器时"
"“%@” has changes" = "“%@”有更改"
