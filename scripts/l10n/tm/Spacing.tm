# Spacing — the Item Spacing pane. "pt" stays: "16 点" would read as 4 p.m.
"%lld pt" = "%lld pt"
"%lld pt (macOS default)" = "%lld pt（macOS 默认）"
"%lld pt, padding %lld pt; room for about %lld more" = "%1$lld pt，边距 %2$lld pt；约可多容纳 %3$lld 项"
"Advanced" = "高级"
"Applies to each app after it is relaunched, and everywhere after you log out and back in." = "每个 App 重新打开后生效；注销并重新登录后全部生效。"
"Apply Custom Values" = "应用自定值"
"Current values" = "当前值"
"Custom" = "自定"
"Default" = "默认"
"Item Spacing" = "项间距"
"Item spacing" = "项间距"
"None" = "无"
"Reset to Default" = "恢复默认"
"Selection padding" = "选择边距"
"Selection padding is the room around an item’s highlight; keep it at or below the spacing so highlights do not overlap." = "选择边距是项高亮区域周围的空白；将它设为不大于项间距，高亮区域才不会重叠。"
"Set Menu Bar Item Spacing" = "设置菜单栏项间距"
"Small" = "小"
"Space between items" = "项之间的间距"
"Spacing" = "间距"
"The spacing could not be saved: macOS kept different values." = "无法存储间距：macOS 保留了不同的值。"
"These values were set outside Rolltop, for example by another app or in Terminal." = "这些值是在 Rolltop 之外设置的，例如由其他 App 或在“终端”中设置。"
"Tiny" = "很小"
"macOS spacing (16 pt, padding 16 pt)" = "macOS 默认间距（16 pt，边距 16 pt）"
"padding, gap, compact, distance between items" = "间距, 边距, 间隙, 紧凑, 项之间的距离"
