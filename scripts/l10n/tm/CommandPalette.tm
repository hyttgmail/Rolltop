# CommandPalette — Search (搜索): the panel, its rows and its pane.
"%@ cannot be opened from Rolltop." = "无法从 Rolltop 打开 %@。"
"%@ did not appear in the menu bar. There may be no room for it." = "%@ 未出现在菜单栏中，可能没有足够的空间。"
"%@ failed: %@" = "%1$@ 失败：%2$@"
"%@ is not running." = "%@ 未在运行。"
"%@: %@" = "%1$@：%2$@"
# Row tag: the profile that is applied.
"Active" = "当前"
"Always hidden" = "始终隐藏"
"Apply profile %@" = "应用预设“%@”"
# Opens Rolltop's Shortcuts pane (keyboard shortcuts).
"Change in Shortcuts…" = "在“快捷键”中更改…"
"Clear History" = "清除历史记录"
"Clear Search History" = "清除搜索历史记录"
"Close" = "关闭"
"Close after running" = "运行后关闭"
"Commands" = "命令"
"Display with the pointer" = "指针所在的显示器"
"Hidden" = "隐藏"
"Include in results" = "包括在结果中"
# VoiceOver: position of a row.
"Item %lld of %lld" = "第 %1$lld 项，共 %2$lld 项"
"Keyboard shortcut" = "键盘快捷键"
"Main display" = "主显示器"
"Menu bar items" = "菜单栏项"
"No results" = "无结果"
"None" = "无"
# Row tag: the item is not drawn in the menu bar.
"Not drawn" = "未显示"
"Nothing to show yet" = "暂无内容"
# Row tag: a command that is on.
"On" = "已开启"
"Open" = "打开"
"Open %@ settings" = "打开“%@”设置"
# Row tag: the item is in the menu bar's overflow menu.
"Overflowed" = "已溢出"
"Profiles" = "预设"
"Results you run often or recently rank higher. The history stays on this Mac and is not part of exported settings or profiles." = "经常或最近运行的结果排名更靠前。历史记录只保存在这台 Mac 上，不包含在导出的设置或预设中。"
"Right-click" = "右键点按"
"Run" = "运行"
"Search" = "搜索"
"Search Menu Bar Items…" = "搜索菜单栏项…"
"Search Menu Bar Items… is also in Rolltop’s menu." = "Rolltop 菜单中也有“搜索菜单栏项…”。"
"Search history" = "搜索历史记录"
"Search menu bar items, profiles and commands" = "搜索菜单栏项、预设和命令"
"Set Shortcut…" = "设置快捷键…"
"Settings" = "设置"
"Show Search" = "显示搜索"
"Show the panel on" = "面板显示位置"
"Shown" = "显示"
"Rolltop needs Device Control and Data Access to open menu bar items." = "Rolltop 需要“设备控制和数据访问”权限才能打开菜单栏项。"
"When off, the panel stays open after a command or profile runs. Menu bar items and settings always close it." = "关闭后，运行命令或预设后面板会保持打开。打开菜单栏项或设置时总会关闭面板。"
"command palette, quick search, find, keyboard, launcher, history" = "搜索, 命令面板, 快速搜索, 查找, 键盘, 启动器, 历史记录"
# Confirmation before a command that changes settings runs from Search.
"Press Return again to run “%@”." = "再按一次 Return 键以运行“%@”。"
