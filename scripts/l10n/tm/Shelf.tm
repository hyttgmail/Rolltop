# Shelf — 搁架: clipboard history (剪贴板历史), file shelf (文件暂存), Up next (即将开始).
"%@ and %lld more" = "%1$@ 等 %2$lld 项"
# Hover delay choices; %@ is a formatted number such as 0.5.
"%@ seconds" = "%@ 秒"
"%@, missing" = "%@，已丢失"
"%lld clips" = "%lld 条"
  en = {"one": "%lld clip", "other": "%lld clips"}
"%lld clips stored" = "已存储 %lld 条剪贴记录"
  en = {"one": "%lld clip stored", "other": "%lld clips stored"}
"%lld clips, kept on this Mac" = "%lld 条剪贴记录，仅保存在这台 Mac 上"
  en = {"one": "%lld clip, kept on this Mac", "other": "%lld clips, kept on this Mac"}
"%lld days" = "%lld 天"
  en = {"one": "%lld day", "other": "%lld days"}
"%lld events" = "%lld 个日程"
  en = {"one": "%lld event", "other": "%lld events"}
"A holding area for files and folders: drop them on the shelf, drag them out later. Rolltop keeps a reference, never a copy; turning it off empties the shelf, not your files." = "文件和文件夹的暂存区：先把它们拖放到搁架上，稍后再拖出来。Rolltop 只保留引用，从不复制；关闭此功能会清空搁架，但不会影响你的文件。"
"Add App…" = "添加 App…"
"After 1 hour" = "1 小时后"
"After 24 hours" = "24 小时后"
"After 7 days" = "7 天后"
"All day: %@" = "全天：%@"
"Allow Access…" = "允许访问…"
"Allow Calendar Access…" = "允许访问日历…"
"Allow Rolltop to read your calendars in System Settings › Privacy & Security › Calendars." = "请在“系统设置 › 隐私与安全 › 日历”中允许 Rolltop 读取你的日历。"
"Allowed" = "已允许"
"Calendar access" = "日历访问权限"
"Calendar access is off" = "日历访问权限已关闭"
"Clear Clipboard History" = "清除剪贴板历史"
"Clear History" = "清除历史记录"
"Clear History…" = "清除历史记录…"
"Clear Shelf" = "清空搁架"
"Clear the clipboard history?" = "要清除剪贴板历史吗？"
"Clear when Rolltop quits" = "Rolltop 退出时清除"
"Clipboard" = "剪贴板"
"Clipboard history" = "剪贴板历史"
"Clipboard history and the file shelf’s references are stored only on this Mac, in ~/Library/Application Support/Rolltop/Shelf, readable only by your user account and left out of Time Machine. Calendar events are read when the shelf opens and never stored. Nothing leaves this Mac." = "剪贴板历史和文件暂存中的引用只存储在这台 Mac 的 ~/Library/Application Support/Rolltop/Shelf 中，只有你的用户帐户可以读取，且不包含在时间机器备份中。日历日程在打开搁架时读取，从不存储。任何内容都不会离开这台 Mac。"
# Palette row subtitle: when it was copied (a relative time) · its kind.
"Copied %@ · %@" = "%1$@拷贝 · %2$@"
"Copy" = "拷贝"
"Delay" = "延迟"
"Delete" = "删除"
"Drag files toward the notch or the top center, then drop them on the shelf. Needs the file shelf." = "将文件拖向刘海或屏幕顶部中央，然后放到搁架上。需要开启文件暂存。"
"Drop files here" = "将文件拖放到此处"
"Events from your calendars appear here." = "你日历中的日程会显示在这里。"
"Every clip except pinned ones is deleted from this Mac." = "除置顶的剪贴记录外，所有剪贴记录都会从这台 Mac 上删除。"
"File shelf" = "文件暂存"
"Files" = "文件"
"Files leave the shelf after %lld hours" = "文件将在 %lld 小时后离开搁架"
  en = {"one": "Files leave the shelf after %lld hour", "other": "Files leave the shelf after %lld hours"}
"Files leave the shelf after %lld seconds" = "文件将在 %lld 秒后离开搁架"
  en = {"one": "Files leave the shelf after %lld second", "other": "Files leave the shelf after %lld seconds"}
"Files stay until you remove them" = "文件会一直保留，直到你将其移除"
# Prompt of the panel that picks an app to ignore.
"Ignore" = "忽略"
"Ignored apps" = "忽略的 App"
"Image" = "图像"
"Image %lld × %lld" = "图像 %1$lld × %2$lld"
"Join" = "加入"
# %@ is a meeting service: Zoom, Google Meet, Teams, Webex, FaceTime.
"Join on %@" = "通过 %@ 加入"
"Keep for" = "保留时长"
"Keep up to" = "最多保留"
"Large" = "大"
"Link" = "链接"
"Medium" = "中"
"Minutes (0 resumes)" = "分钟数（0 表示继续）"
"Missing" = "已丢失"
"More" = "更多"
"Never" = "永不"
"No matches" = "无匹配项"
"Nothing copied yet" = "尚未拷贝任何内容"
"Nothing else today or tomorrow" = "今天和明天没有其他日程"
"Nothing in the history contains these words." = "历史记录中没有包含这些字词的内容。"
"Nothing is recorded while one of these apps is in front. Password managers are listed already." = "这些 App 位于最前面时不会记录任何内容。密码管理器已列在其中。"
"Nothing on the shelf yet" = "搁架上还没有内容"
"On a display without a notch, the top center of the menu bar. “Shelf” in Rolltop’s menu and its shortcut always open it." = "在没有刘海的显示器上，即菜单栏顶部中央。Rolltop 菜单中的“搁架”及其快捷键始终可以打开它。"
"Open" = "打开"
"Open Privacy Settings" = "打开隐私设置"
"Open when dragging files to the top of the screen" = "将文件拖到屏幕顶部时打开"
"Open when the pointer rests on the notch" = "指针停留在刘海上时打开"
"Opening" = "打开方式"
"Panel size" = "面板大小"
"Pause" = "暂停"
"Pause Clipboard History" = "暂停剪贴板历史"
"Pause for %lld Hours" = "暂停 %lld 小时"
  en = {"one": "Pause for %lld Hour", "other": "Pause for %lld Hours"}
"Pause for %lld Minutes" = "暂停 %lld 分钟"
  en = {"one": "Pause for %lld Minute", "other": "Pause for %lld Minutes"}
"Paused until %@" = "已暂停，直到 %@"
"Paused until %@. What you copy meanwhile is not recorded." = "已暂停，直到 %@。在此期间拷贝的内容不会被记录。"
"Pin" = "置顶"
"Pinned" = "已置顶"
"Pinned clips stay until you unpin or delete them." = "置顶的剪贴记录会一直保留，直到你取消置顶或将其删除。"
"Privacy" = "隐私"
"Quick Look" = "快速查看"
"Recording" = "记录"
"Records the text, rich text, links, file references and images you copy, on this Mac only. Skips what apps mark as concealed or temporary and anything copied in an ignored app. Turning it off deletes the history." = "记录你拷贝的文本、富文本、链接、文件引用和图像，仅保存在这台 Mac 上。会跳过 App 标记为隐藏或临时的内容，以及在忽略的 App 中拷贝的任何内容。关闭此功能会删除历史记录。"
"Remove" = "移除"
"Remove a file after dragging it out" = "拖出文件后将其移除"
"Remove files" = "移除文件"
"Remove from Shelf" = "从搁架中移除"
"Restore Defaults" = "恢复默认"
"Resume" = "继续"
"Search" = "搜索"
"Search clipboard history" = "搜索剪贴板历史"
"Section" = "部分"
"Shelf" = "搁架"
"Shelf Settings" = "搁架设置"
"Shelf Settings…" = "搁架设置…"
"Show Shelf" = "显示搁架"
"Show in Finder" = "在访达中显示"
"Show up to" = "最多显示"
"Shows the next events of today and tomorrow, with a Join button for Zoom, Google Meet, Teams, Webex and FaceTime links. Turning it on asks for access to your calendars." = "显示今天和明天即将开始的日程，并为 Zoom、Google Meet、Teams、Webex 和 FaceTime 链接提供“加入”按钮。开启后会请求访问你的日历。"
"Small" = "小"
"Rolltop reads today’s and tomorrow’s events when the shelf opens and stores none of them." = "Rolltop 会在打开搁架时读取今天和明天的日程，且不会存储任何日程。"
"Text" = "文本"
"Text, links, files and images you copy appear here. Choosing one copies it again; paste it with ⌘V." = "你拷贝的文本、链接、文件和图像会显示在这里。选择其中一项会再次拷贝它，然后按 ⌘V 粘贴。"
"The shelf keeps a reference, not a copy. Drag them out again wherever you need them." = "搁架只保留引用，不会复制文件。需要时可以将它们拖到任何位置。"
"Today" = "今天"
"Tomorrow" = "明天"
"Turn on clipboard history, the file shelf or Up next in Settings. Each is off until you choose it." = "在设置中开启剪贴板历史、文件暂存或“即将开始”。在你开启之前，它们都处于关闭状态。"
"Unpin" = "取消置顶"
"Up next" = "即将开始"
"Up next needs your calendars" = "“即将开始”需要访问你的日历"
"What is stored where" = "存储内容和位置"
"Without it, Up next explains what it needs instead of listing events." = "没有此权限时，“即将开始”会说明它需要什么，而不会列出日程。"
"macOS asks before Rolltop reads what you copy. To record without being asked each time, allow pasting from other apps for Rolltop in System Settings › Privacy & Security." = "Rolltop 读取你拷贝的内容前，macOS 会先询问。若要在记录时不再每次询问，请在“系统设置 › 隐私与安全”中允许 Rolltop 从其他 App 粘贴。"
"macOS does not let Rolltop read what you copy. Allow pasting from other apps for Rolltop in System Settings › Privacy & Security." = "macOS 不允许 Rolltop 读取你拷贝的内容。请在“系统设置 › 隐私与安全”中允许 Rolltop 从其他 App 粘贴。"
# Relative time for something copied within the last minute.
"now" = "刚刚"
"shelf, notch, clipboard, history, copy, paste, files, drop, drag, calendar, events, up next, meeting, join, privacy, hints, volume, brightness, battery, now playing, music, weather" = "搁架, 刘海, 剪贴板, 历史记录, 拷贝, 粘贴, 文件, 拖放, 拖移, 日历, 日程, 即将开始, 会议, 加入, 隐私, 提示, 音量, 亮度, 电池, 正在播放, 音乐, 天气"
# Round 2: hints, cards, direct paste, Calendars consent row.
# Hint titles; %@ is a formatted percentage such as 44%.
"Volume %@" = "音量 %@"
"Brightness %@" = "亮度 %@"
"Muted" = "已静音"
"Charging · %lld%%" = "正在充电 · %lld%%"
"On battery · %lld%%" = "正在使用电池 · %lld%%"
"Battery low · %lld%%" = "电池电量不足 · %lld%%"
"Fully charged" = "已充满"
"Copied, not pasted: the app you were in didn’t come back in time." = "已拷贝，未粘贴：你之前使用的 App 未能及时回到前台。"
"Copied, not pasted: Rolltop needs Device Control and Data Access." = "已拷贝，未粘贴：Rolltop 需要“设备控制和数据访问”权限。"
"Calendars" = "日历"
"Shows your next events in the shelf and in widgets." = "在搁架和小组件中显示你接下来的日程。"
"Calendar access is restricted on this Mac." = "这台 Mac 限制了日历访问。"
"Paste" = "粘贴"
"Rolltop needs permission to control the player." = "Rolltop 需要权限才能控制播放器。"
"Permissions…" = "权限…"
"Open Settings › Permissions" = "打开“设置 › 权限”"
"Previous" = "上一首"
"Play" = "播放"
"Next" = "下一首"
# Weather card second line: place · today's high and low · time of the report.
"%@ · H %@ L %@ · %@" = "%1$@ · 最高 %2$@ 最低 %3$@ · %4$@"
"Choose a place for the weather" = "为天气选择一个地点"
"Weather Settings…" = "天气设置…"
"When you choose a clip" = "选择剪贴记录时"
"Copy it" = "拷贝"
"Copy and paste it into the frontmost app" = "拷贝并粘贴到最前面的 App"
"Pasting needs Device Control and Data Access and sends one ⌘V to the frontmost app. Option-click a clip in the shelf, or press ⌘Return in Search, to do the other." = "粘贴需要“设备控制和数据访问”权限，并会向最前面的 App 发送一次 ⌘V。在搁架中按住 Option 键点按剪贴记录，或在搜索中按 ⌘Return，可执行另一种操作。"
"Cards" = "卡片"
"Now playing" = "正在播放"
"Shows what is playing in Music or Spotify, with controls, once Rolltop may read that app (Settings › Permissions)." = "显示“音乐”或 Spotify 正在播放的内容并提供控制按钮，前提是 Rolltop 可以读取该 App（设置 › 权限）。"
"Weather" = "天气"
"Shows the weather for the place chosen in Weather settings, while weather is on." = "天气功能打开时，显示在天气设置中所选地点的天气。"
"Hints" = "提示"
"Show hints" = "显示提示"
"A small expansion of the shelf briefly shows what changed. macOS shows its own volume and brightness indicator; Rolltop’s hint appears in addition to it." = "搁架会短暂展开一小块，显示刚刚发生的变化。macOS 会显示自己的音量和亮度指示器；Rolltop 的提示会与其同时出现。"
"Volume" = "音量"
"Brightness" = "亮度"
"Battery" = "电池"
"Plugged in, unplugged, fully charged, and when the battery runs low." = "接通电源、断开电源、充满电，以及电量偏低时。"
