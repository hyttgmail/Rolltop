# AppShortcuts — Siri and Spotlight phrases. Every phrase must contain ${applicationName}.
"Apply a ${applicationName} profile" = ["应用 ${applicationName} 预设", "切换 ${applicationName} 预设"]
"Hide hidden items in ${applicationName}" = ["用 ${applicationName} 收起隐藏项", "用 ${applicationName} 整理菜单栏"]
"Show hidden items in ${applicationName}" = ["在 ${applicationName} 中显示隐藏项", "用 ${applicationName} 显示隐藏的菜单栏项"]
"Toggle hidden items in ${applicationName}" = ["在 ${applicationName} 中切换隐藏项", "切换 ${applicationName}"]
