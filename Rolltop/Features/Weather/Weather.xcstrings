            "value" : "移除"
          }
        }
      }
    },
    "Rolltop sends the approximate location of the place you choose to Open-Meteo (open-meteo.com), a free weather service, to get the forecast. Open-Meteo’s servers may log it with your IP address. Nothing is sent while this is off." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 会将你所选地点的大致位置发送给免费天气服务 Open-Meteo（open-meteo.com）以获取天气预报。Open-Meteo 的服务器可能会将其与你的 IP 地址一起记录。关闭时不会发送任何内容。"
          }
        }
      }
    },
    "Search for a city" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索城市"
