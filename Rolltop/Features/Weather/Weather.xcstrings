  "strings" : {
    "%@, feels like %@, high %@, low %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, feels like %2$@, high %3$@, low %4$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，体感 %2$@，最高 %3$@，最低 %4$@"
          }
        }
      }
    },
    "Choose a place" : {
      "localizations" : {
