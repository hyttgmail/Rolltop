    "Parts of Rolltop are adapted from Hidden Bar by Dwarves Foundation and Console Labs, used under the MIT License." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 的部分代码改写自 Dwarves Foundation 和 Console Labs 的 Hidden Bar，依据 MIT 许可证使用。"
