          }
        }
      }
    },
    "macOS refused this shortcut (error %d); another app may use it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒绝了此快捷键（错误 %d），它可能已被其他 App 使用。"
          }
        }
      }
    },
    "macOS uses this shortcut. Change it here or turn it off in System Settings › Keyboard › Keyboard Shortcuts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已使用此快捷键。可以在此处更改，或在“系统设置 › 键盘 › 键盘快捷键”中关闭它。"
          }
        }
      }
    }
