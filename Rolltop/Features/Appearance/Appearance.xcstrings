    "Style the menu bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置菜单栏样式"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统默认"
          }
        }
      }
    },
    "The menu bar hides automatically, so styling is paused. Choose “Never” for “Automatically hide and show the menu bar” in System Settings › Menu Bar to use it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏会自动隐藏，因此样式已暂停。要使用样式，请在“系统设置 › 菜单栏”中将“自动隐藏和显示菜单栏”设为“永不”。"
          }
        }
      }
    },
    "The menu bar looks as macOS draws it. Nothing runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏保持 macOS 绘制的样子，不运行任何内容。"
          }
        }
      }
    },
