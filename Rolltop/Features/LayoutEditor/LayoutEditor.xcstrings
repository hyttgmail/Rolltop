          "stringUnit" : {
            "state" : "translated",
            "value" : "其他项"
          }
        }
      }
    },
    "Put New Items in Always Hidden" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将新项放入“始终隐藏”"
          }
