{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld items" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld 项"
                }
              }
            }
          }
        }
      }
    },
    "%lld items, which always move together" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items, which always move together"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld 项，始终一起移动"
                }
              }
            }
          }
        }
      }
    },
    "Always shown" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终显示"
          }
        }
      }
    },
    "An app started while its section is hidden only shows up here after it has been in the menu bar once." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其分区处于隐藏状态时启动的 App，要在菜单栏中出现过一次后才会显示在这里。"
          }
        }
      }
    },
    "App" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App"
          }
        }
      }
    },
    "Apps Rolltop hasn’t seen before appear here. Items already in your menu bar keep their section." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 之前没见过的 App 会出现在这里。已在菜单栏中的项保持原有分区。"
          }
        }
      }
    },
    "Apps Rolltop hasn’t seen before appear in this section. Drag this to another column to change it; items already in your menu bar stay where they are." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 之前没见过的 App 会出现在此分区。将它拖到另一栏即可更改；已在菜单栏中的项保持不变。"
          }
        }
      }
    },
    "Apps Turned Off in the Menu Bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏中关闭的 App"
          }
        }
      }
    },
    "Choose File…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取文件…"
          }
        }
      }
    },
    "Choose “%@” to let Rolltop read it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取“%@”以允许 Rolltop 读取它。"
          }
        }
      }
    },
    "Clear filter" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除过滤条件"
          }
        }
      }
    },
    "Columns" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分栏"
          }
        }
      }
    },
    "Couldn’t open the item: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开该项：%@"
          }
        }
      }
    },
    "Doesn’t fit in the menu bar right now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前菜单栏中放不下。"
          }
        }
      }
    },
    "Drag items here" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将项拖到此处"
          }
        }
      }
    },
    "Filter items" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过滤项"
          }
        }
      }
    },
    "Forget" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记"
          }
        }
      }
    },
    "Hidden now" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前已隐藏"
          }
        }
      }
    },
    "Hiding works per app: all of an app’s icons share one section and move together." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏以 App 为单位：一个 App 的所有图标共用一个分区，并一起移动。"
          }
        }
      }
    },
    "Icons that don’t fit in the menu bar go into its overflow menu; Rolltop can’t open items from there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏中放不下的图标会进入溢出菜单；Rolltop 无法从那里打开项。"
          }
        }
      }
    },
    "In the menu bar’s overflow menu (no room)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏的溢出菜单中（空间不足）"
          }
        }
      }
    },
    "Items appear in menu bar order, left to right. Drop an item on another one in the same row to put it there, or hold ⌘ and drag icons in the menu bar itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项按菜单栏中从左到右的顺序排列。将一个项拖放到同一行的另一个项上即可把它移到那里，也可以在菜单栏中按住 ⌘ 拖移图标。"
          }
        }
      }
    },
    "Items appear in menu bar order, left to right. Rolltop can’t change the order: hold ⌘ and drag icons in the menu bar itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项按菜单栏中从左到右的顺序排列。Rolltop 无法更改顺序：请在菜单栏中按住 ⌘ 拖移图标。"
          }
        }
      }
    },
    "Lets you reorder menu bar items in Settings › Menu Bar Items." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让你在“设置 › 菜单栏项”中调整菜单栏项的顺序。"
          }
        }
      }
    },
    "List" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表"
          }
        }
      }
    },
    "Lists the apps you turned off in System Settings › Menu Bar. Rolltop only reads this list." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出你在“系统设置 › 菜单栏”中关闭的 App。Rolltop 只读取此列表。"
          }
        }
      }
    },
    "Managed by macOS" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 macOS 管理"
