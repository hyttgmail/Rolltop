    "Allow Calendars in Settings › Permissions to show your next event. Until then the widget is hidden." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 › 权限”中允许访问日历即可显示下一个日程。在此之前小组件会隐藏。"
          }
        }
      }
    },
    "Always hidden" : {
