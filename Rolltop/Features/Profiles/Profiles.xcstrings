        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 个隐藏，%2$lld 个始终隐藏"
          }
        }
      }
    },
    "%lld profiles" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld profile"
