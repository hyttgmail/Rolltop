{
  "sourceLanguage" : "en",
  "strings" : {
    "A second click hides them again. Option-click also shows always-hidden items." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次点按会将它们重新隐藏。按住 Option 键点按还会显示始终隐藏的项。"
          }
        }
      }
    },
    "After %lld seconds" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "After %lld second"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "After %lld seconds"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld 秒后"
                }
              }
            }
          }
        }
      }
    },
    "After 1 minute" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 分钟后"
          }
        }
      }
    },
    "Applies" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生效范围"
          }
        }
      }
    },
    "Click an empty part of the menu bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按菜单栏的空白处"
          }
        }
      }
    },
    "Counted from your last action. Waits while the pointer is in the menu bar or a menu is open." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从你上次操作时开始计时。指针在菜单栏中或有菜单打开时会继续等待。"
          }
        }
      }
    },
    "Decided by the display under the pointer when the items are shown." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由显示这些项时指针所在的显示器决定。"
          }
        }
      }
    },
    "Device Control and Data Access is off" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设备控制和数据访问”已关闭"
          }
        }
      }
    },
    "Down or left shows hidden items, up or right hides them. Scrolling over an item is left to that item." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向下或向左显示隐藏项，向上或向右将其隐藏。在某一项上滚动时，交由该项自行处理。"
          }
        }
      }
    },
    "Hidden items open in the Rolltop Bar and need no room. When items show in the menu bar, as after Option-click, the other items step aside, except %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏项会在 Rolltop 栏中打开，不占用菜单栏空间。当项显示在菜单栏中时（例如按住 Option 键点按后），除%@之外的其他项会让出位置。"
          }
        }
      }
    },
    "Hide Everything" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部隐藏"
          }
        }
      }
    },
    "Hide automatically" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动隐藏"
          }
        }
      }
    },
    "Hide everything" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部隐藏"
          }
        }
      }
    },
    "Hide them again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次隐藏"
          }
        }
      }
    },
    "Hides all items except %@ until you turn it off. Showing hidden items puts them in place of the ones you normally see. macOS also hides AirDrop, Focus and Now Playing while anything is hidden." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏除%@之外的所有项，直到你将其关闭。显示隐藏项时，它们会替代你平时看到的项。只要有项被隐藏，macOS 也会隐藏隔空投送、专注模式和“播放中”。"
          }
        }
      }
    },
    "Hides all items except %@ until you turn it off. The Rolltop Bar still lists the hidden items, not the ones you normally see. macOS also hides AirDrop, Focus and Now Playing while anything is hidden." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏除%@之外的所有项，直到你将其关闭。Rolltop 栏仍只列出隐藏项，而不是你平时看到的项。只要有项被隐藏，macOS 也会隐藏隔空投送、专注模式和“播放中”。"
          }
        }
      }
    },
    "Hover delay" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬停延迟"
          }
        }
      }
    },
    "Hover over the menu bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针悬停在菜单栏上"
          }
        }
      }
    },
    "Keep it on after Rolltop restarts" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 重新启动后保持开启"
          }
        }
      }
    },
    "Make Room When Showing Hidden Items" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示隐藏项时腾出空间"
          }
        }
      }
    },
    "Make room" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腾出空间"
          }
        }
      }
    },
    "Make room for hidden items" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为隐藏项腾出空间"
          }
        }
      }
    },
    "Minimal menu bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "极简菜单栏"
          }
        }
      }
    },
    "Never" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不"
          }
        }
      }
    },
    "Not when an item you clicked opens its own app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按的项打开其自身的 App 时除外。"
          }
        }
      }
    },
    "On every display" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有显示器上"
          }
        }
      }
    },
    "Only on displays with a notch" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在有刘海的显示器上"
          }
        }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开设置"
          }
        }
      }
    },
    "Reveal" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示与收起"
          }
        }
      }
    },
    "Rolltop needs it to tell empty menu bar space from items. Until then only Rolltop’s icon and shortcuts show hidden items." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 需要它来区分菜单栏中的空白处和项。在此之前，只有 Rolltop 图标和快捷键能显示隐藏项。"
          }
        }
      }
    },
    "Scroll again to show always-hidden items" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次滚动以显示始终隐藏的项"
          }
        }
      }
    },
    "Scroll or swipe in the menu bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏中滚动或轻扫"
          }
        }
      }
    },
    "Show Hidden Items Until Hidden Again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续显示隐藏项直至再次隐藏"
          }
        }
      }
    },
    "Show hidden items when I" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在以下情况下显示隐藏项"
          }
        }
      }
    },
    "The Rolltop Bar closes on its own (see Rolltop Bar). These apply when items show in the menu bar, as after Option-click." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 栏会自行关闭（见“Rolltop 栏”设置）。以下设置适用于项显示在菜单栏中时，例如按住 Option 键点按后。"
          }
        }
      }
    },
    "The Rolltop Bar closes when the pointer leaves it and the menu bar. Hold ⌘ to rearrange items without showing them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针离开 Rolltop 栏和菜单栏后，Rolltop 栏会关闭。按住 ⌘ 可以在不显示隐藏项的情况下重新排列项。"
          }
        }
      }
    },
    "They hide again when the pointer leaves the menu bar. Hold ⌘ to rearrange items without showing them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针离开菜单栏后，它们会再次隐藏。按住 ⌘ 可以在不显示隐藏项的情况下重新排列项。"
          }
        }
      }
    },
    "When I click outside the menu bar" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏外点按时"
          }
        }
      }
    },
    "When I switch to another app" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到其他 App 时"
          }
        }
      }
    },
    "While hidden items are shown, the other items step aside, except %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示隐藏项时，除%@之外的其他项会让出位置。"
          }
        }
      }
    },
    "show hidden items, click, hover, scroll, swipe, gesture, hide automatically, rehide, make room, hide everything, notch" : {
      "comment" : "Settings search keywords, comma separated",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示隐藏项, 点按, 悬停, 滚动, 轻扫, 手势, 自动隐藏, 再次隐藏, 腾出空间, 全部隐藏, 刘海"
          }
        }
      }
    }
  },
  "version" : "1.0"
}