{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow Device Control and Data Access…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许设备控制和数据访问…"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成"
          }
        }
      }
    },
    "Lets Rolltop see which items are in the menu bar, and hide or open them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Rolltop 看到菜单栏中有哪些项，并隐藏或打开它们。"
          }
        }
      }
    },
    "Rolltop hides the menu bar items you don’t need all the time. Click its icon in the menu bar to bring them back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolltop 会隐藏你不常用的菜单栏项。\n点按菜单栏中的 Rolltop 图标即可让它们重新出现。"
          }
        }
      }
    },
    "Shows the real icons of hidden items. You can skip this: Rolltop then shows app icons." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示隐藏项的真实图标。可以跳过：Rolltop 会改为显示 App 图标。"
          }
        }
      }
    },
    "Step 1" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 1 步"
          }
        }
      }
    },
    "Step 2, optional" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 2 步（可选）"
          }
        }
      }
    },
    "Welcome to Rolltop" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎使用 Rolltop"
          }
        }
      }
    },
    "You can allow it later in Settings › Permissions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以稍后在“设置 › 权限”中允许。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}